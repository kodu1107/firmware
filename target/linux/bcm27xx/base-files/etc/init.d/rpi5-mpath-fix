#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1
PROG=/usr/sbin/rpi5-mpath-fix

start_service() {
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "bcm2712,mm6108-spi" ] || return 0

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
